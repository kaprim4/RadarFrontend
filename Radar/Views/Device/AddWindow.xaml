<UserControl x:Class="Radar.Views.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Radar.Views"
        xmlns:viewmodels="clr-namespace:Radar.ViewModels" 
        mc:Ignorable="d"
        d:DesignHeight="450" 
        d:DesignWidth="800" 
        Background="Transparent">
    <Border CornerRadius="8" Background="White" BorderBrush="Black" OpacityMask="Black" Margin="15" Padding="15">
        <Grid  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="*"/>
                <RowDefinition />
            </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="32" FontWeight="SemiBold" Foreground="#121518" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 0 0 25"><Run Language="fr-fr" Text="Radars"/></TextBlock>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="20"><Run Language="fr-fr" Text="Serial Number"/><Run Text=" :"/></TextBlock>
                <TextBox Grid.Row="1" Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Height="20"/>

                <CheckBox Grid.Row="2" x:Name="myCheckBox" Content="is Active" 
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Margin="0 10"  IsChecked="{Binding IsActive, Mode=TwoWay}"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Height="50">
                <Button Content="Cancel" Width="75" Margin="5,0,0,0" Command="{Binding CancelCommand}" Style="{StaticResource cancelButton}" Background="#FFCACACA"/>
                <Button Content="Save" Width="75" Margin="5,0,0,0" Command="{Binding SaveCommand}" Style="{StaticResource addButton}"  />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
